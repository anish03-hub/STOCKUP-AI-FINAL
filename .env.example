# StockUp AI Environment Variables Example
# Copy to .env for local development

# ── Frontend (Vite) Configuration ──
# Base API URL for Spring Boot backend.
# Local development (default): /api (uses Vite proxy to http://localhost:8080)
# Production (Render): https://stockup-ai-backend.onrender.com/api
# VITE_API_BASE_URL=https://stockup-ai-backend.onrender.com/api

# Google OAuth Client ID obtained from Google Cloud Console (APIs & Services > Credentials)
# Web application type, Authorized JavaScript origins: http://localhost:5173
VITE_GOOGLE_CLIENT_ID=your_google_client_id_here.apps.googleusercontent.com

# ── Backend (Spring Boot) Configuration ──
# Google OAuth Client ID for server-side ID Token verification
GOOGLE_CLIENT_ID=your_google_client_id_here.apps.googleusercontent.com

# PostgreSQL Database Configuration
DATABASE_URL=jdbc:postgresql://localhost:5432/stockup_ai
DATABASE_USERNAME=postgres
DATABASE_PASSWORD=postgres

# JWT Signing Secret (256-bit key)
JWT_SECRET=404E635266556A586E3272357538782F413F4428472B4B6250645367566B5970

# ── SMTP Email Delivery Configuration (Medicine Expiry Alerts) ──
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your_smtp_username@gmail.com
MAIL_PASSWORD=your_app_password
MAIL_FROM=alerts@stockup.ai

